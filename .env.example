# Optional overrides for docker-compose.yml. Copy to .env to change them.
# .env is ignored by git. Never commit it, and never put a real secret in this file.
#
# A variable that is commented out or left empty is "not set": the service uses its default.
# The variables, their validation and their defaults are defined in
# packages/shared/src/config/settings.ts.

# --- PostgreSQL container (local development values only) ---
POSTGRES_USER=arlo
POSTGRES_PASSWORD=arlo-dev-only
POSTGRES_DB=arlo
# Port published on the host. The services inside Compose always use postgres:5432.
POSTGRES_PORT=5432

# --- Database connection of a service ---
# docker-compose.yml sets these for both services from the POSTGRES_* values above.
# Uncomment them only to run a service or the migration command outside Docker:
#   node --env-file=.env services/core/dist/main.js
#   pnpm db:migrate
# The connector refuses to start when a credential from the last section is set, so run it
# with an env file of its own, and not from a shell that exports ANTHROPIC_API_KEY.
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=5432
# DATABASE_USER=arlo
# DATABASE_PASSWORD=arlo-dev-only
# DATABASE_NAME=arlo

# --- Thresholds and time constants (design §9.2); the value shown is the default ---
# Conversation window, read by connector and core.
# PIPELINE_WINDOW_QUIET_SECONDS=45
# PIPELINE_WINDOW_MAX_MESSAGES=30
# PIPELINE_WINDOW_MAX_WAIT_SECONDS=180
# Core only.
# TASK_CONFIDENCE_THRESHOLD=0.8
# REMINDER_MAX_PER_TASK=3
# QUIET_HOURS_DEFAULT_START=22:00
# QUIET_HOURS_DEFAULT_END=08:00
# LINE_OA_REPLY_DEADLINE_SECONDS=50
# BINDING_CODE_TTL_SECONDS=600
# MESSAGE_RETENTION_OPTIONS_DAYS=7,30,90

# --- Undecided values (design §9.2 lists them as 未定); core only ---
# They have no default. Unset, the service starts and the value is absent, never a number.
# The two scam levels must be set together, medium below high.
SCAM_CONFIDENCE_HIGH_MIN=
SCAM_CONFIDENCE_MEDIUM_MIN=
# Whether the budget counts messages or money, and the unit of the threshold, are undecided.
WHATSAPP_MONTHLY_BUDGET=
WHATSAPP_DAILY_REPLY_LIMIT_PER_USER=
WHATSAPP_LONG_RESULT_THRESHOLD=
MEMORY_MAX_ENTRIES=

# --- Credentials; core only, the connector must not be given any of them ---
# Each one is optional until the feature that uses it is built. Leave them empty here and
# put real values only in .env.
ANTHROPIC_API_KEY=
# Comma-separated OAuth client IDs accepted as the audience of a Google ID token.
GOOGLE_OAUTH_CLIENT_IDS=
# At least 32 characters.
AUTH_TOKEN_SIGNING_KEY=
# The JSON of the Firebase service-account key file on one line, in single quotes.
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_MAPS_API_KEY=
# Set both or neither.
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# Set both or neither.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
