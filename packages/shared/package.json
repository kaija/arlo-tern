{
  "name": "@arlo-tern/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "@arlo-tern/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "@arlo-tern/source": "./src/config/index.ts",
      "types": "./dist/config/index.d.ts",
      "default": "./dist/config/index.js"
    },
    "./db": {
      "@arlo-tern/source": "./src/db/index.ts",
      "types": "./dist/db/index.d.ts",
      "default": "./dist/db/index.js"
    },
    "./connector": {
      "@arlo-tern/source": "./src/connector/index.ts",
      "types": "./dist/connector/index.d.ts",
      "default": "./dist/connector/index.js"
    },
    "./connector/testing": {
      "@arlo-tern/source": "./src/connector/testing/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "kysely": "^0.29.9",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}
